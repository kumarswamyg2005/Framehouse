# ---------------------------------------------------------------------------
# Database (Neon Postgres). Pooled URL for the app, direct URL for migrations.
# ---------------------------------------------------------------------------
# Local (docker compose): postgresql://framehouse:framehouse@localhost:5433/framehouse
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Auth. JWT_SECRET must be >= 32 bytes of randomness:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=
# Salt for hashing client IPs before they are written to PinAttempt.
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# Object storage, S3-compatible. Bucket MUST be private — no public access.
#
# Production: Cloudflare R2. Leave R2_ENDPOINT unset and it is derived from
#   R2_ACCOUNT_ID as https://<account>.r2.cloudflarestorage.com
#
# Local (docker compose up -d starts MinIO):
#   R2_ACCOUNT_ID=local
#   R2_ACCESS_KEY_ID=framehouse
#   R2_SECRET_ACCESS_KEY=framehouse-dev-secret
#   R2_BUCKET=framehouse-dev
#   R2_ENDPOINT=http://localhost:9000
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: overrides https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used to build shareable gallery links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed only (npm run db:seed). Never set these in production.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@demo.test
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=
SEED_GALLERY_PIN=

# Optional. Shown as a link in the entry page footer.
NEXT_PUBLIC_REPO_URL=
